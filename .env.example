# Puerto HTTP. En Render y Railway lo asigna la plataforma. No lo fije alli.
PORT=3000

# Entorno de ejecucion
NODE_ENV=production

# Zona horaria de programacion, auditoria y correos
TZ=America/Bogota

# Secreto de sesion. Obligatorio en produccion. Genere un valor largo y aleatorio.
SESSION_SECRET=cambiar-por-un-secreto-largo

# Clave de cifrado de copias de seguridad. Si se omite, se usa SESSION_SECRET.
BACKUP_KEY=cambiar-por-clave-de-cifrado-de-backups

# URL publica del servicio. La usa el programador de copias y enlaces de descarga.
# Ejemplo: https://gestor-informacion.onrender.com
PUBLIC_URL=

# Directorio persistente de SQLite, esquema y respaldos. En Docker Compose
# el volumen ya monta /app/data. En Render/Railway asigne un disco aqui.
# DATA_DIR=/app/data

# El SMTP institucional se configura en la aplicacion (Base de Datos / correo),
# no por variables de entorno. No coloque claves reales en este archivo.
